#
# 文件名字: Part0_Global.env
# 文件说明: 全局变量配置
# 使用说明: 按需修改变量值，自动加载生效
#
# Copyright (c) 2026 frostcypress
#

# 固件前缀名称
SOURCE_NAME=LEDE
# OpenWrt源码仓库地址
REPO_URL=https://github.com/coolsnowwolf/lede
# 源码分支
REPO_BRANCH=20251001
# 更新日志
RELEASE_NOTES=release.txt

# 软件源配置脚本
PART1_FEEDS=Part1_Feeds.sh
# 自定义配置脚本
PART2_CUSTOM=Part2_Custom.sh

# 是否上传完整编译bin目录
UPLOAD_BIN_DIR=false
# 是否上传编译好的固件
UPLOAD_FIRMWARE=true
# 是否发布到Releases
UPLOAD_RELEASE=true

# 是否启用编译加速
USE_CCACHE=true
# 编译数据存放目录
CACHE_SYNC=/workdir/chenos

# 设置时区 (默认-上海)
TZ=Asia/Shanghai
